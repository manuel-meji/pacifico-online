<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cobertura del código de M2 (reporte de la sección 8 del PC4). Corre la suite completa
  de la plataforma, pero mide solo el código de M4. Necesita pcov o Xdebug:

    php -d pcov.enabled=1 vendor/bin/phpunit -c tests/phpunit-cobertura-M2.xml
        (agregar las opciones coverage-html storage/cobertura-m2 y coverage-text)

  Las rutas son relativas a esta carpeta (tests/).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../app/Contracts/M2_Comercios</directory>
            <directory>../app/Events/M2_Comercios</directory>
            <directory>../app/Http/Controllers/M2_Comercios</directory>
            <directory>../app/Listeners/M2_Comercios</directory>
            <directory>../app/Models/M2_Comercios</directory>
            <directory>../app/Policies/M2_Comercios</directory>
            <directory>../app/Services/M2_Comercios</directory>
            <file>../app/Providers/M2ComerciosServiceProvider.php</file>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" force="true" value="sqlite"/>
        <env name="DB_DATABASE" force="true" value=":memory:"/>
        <env name="DB_URL" force="true" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
